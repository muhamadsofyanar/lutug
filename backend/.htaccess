# INSYARAH BACKEND CONFIGURATION

# 1. Prevent Directory Listing
Options -Indexes

# 2. CORS Headers (Backup if PHP fails)
<IfModule mod_headers.c>
    Header set Access-Control-Allow-Origin "*"
    Header set Access-Control-Allow-Methods "GET, POST, OPTIONS, PUT, DELETE"
    Header set Access-Control-Allow-Headers "Content-Type, Authorization, X-Requested-With"
</IfModule>

# 3. Handle OPTIONS method for CORS pre-flight
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteCond %{REQUEST_METHOD} OPTIONS
    RewriteRule ^(.*)$ $1 [R=200,L]
</IfModule>

# 4. Protect Sensitive Files
<FilesMatch "^\.">
    Order allow,deny
    Deny from all
</FilesMatch>

<FilesMatch "\.(sqlite|db|log|env|ini)$">
    Order allow,deny
    Deny from all
</FilesMatch>

# 5. Allow access to public API
<Files "index.php">
    Order allow,deny
    Allow from all
</Files>
